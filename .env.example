# Variables para docker compose. Copia este archivo como .env y cambia los valores.
POSTGRES_PASSWORD=cambia_esta_clave
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
# true = el frontend usa datos de prueba en vez de la API (requiere reconstruir)
NEXT_PUBLIC_USE_MOCKS=false
# Puerto de la base de Docker en tu PC
POSTGRES_PORT=5434
# Correo de alerta de stock mínimo (opcional). Con Gmail usa una contraseña de
# aplicación, nunca la de tu cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CORREO_ADMIN=
