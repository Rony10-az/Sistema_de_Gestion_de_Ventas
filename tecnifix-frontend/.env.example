# Copia este archivo como .env.local y ajusta los valores. .env.local NO se sube.

# URL base del backend (sin /api/, las rutas van directo, ej. /productos)
NEXT_PUBLIC_API_URL=http://localhost:4000

# true = usar los datos de prueba de src/mocks/ (no hace falta el backend)
# false = llamar a la API real en NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCKS=true
