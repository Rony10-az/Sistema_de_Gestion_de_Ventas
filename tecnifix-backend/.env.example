# Copia este archivo como .env con:  npm run env:init
# El .env nunca se sube a Git.

# Servidor
PORT=4000
NODE_ENV=development

# CORS: origen(es) permitidos, separados por coma (el frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_ventas
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d
