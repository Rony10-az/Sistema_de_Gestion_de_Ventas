{
  "name": "tecnifix-backend",
  "version": "1.0.0",
  "description": "API REST de TecniFix, ventas e inventario (Express + PostgreSQL + JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "env:init": "node src/database/cli.js env-init",
    "db:check": "node src/database/cli.js check",
    "db:create": "node src/database/cli.js create",
    "db:migrate": "node src/database/cli.js migrate",
    "db:seed": "node src/database/cli.js seed",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --selectProjects unit --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.11.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
