meta {
  name: Crear cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipo_documento": "DNI",
    "documento": "{{documento}}",
    "nombre": "Cliente Bruno",
    "telefono": "900000000",
    "email": "cliente.bruno@example.com",
    "direccion": "Av. Bruno 123"
  }
}

script:pre-request {
  bru.setVar("documento", String(Date.now()).slice(-8));
}

script:post-response {
  bru.setVar("clienteId", res.getBody().id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
