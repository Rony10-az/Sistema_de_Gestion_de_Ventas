meta {
  name: Actualizar cliente
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/clientes/{{clienteId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipo_documento": "DNI",
    "documento": "{{documento}}",
    "nombre": "Cliente Bruno",
    "telefono": "911111111",
    "email": "cliente.bruno@example.com",
    "direccion": "Av. Bruno 123"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
