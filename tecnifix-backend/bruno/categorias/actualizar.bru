meta {
  name: Actualizar categoría
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/categorias/{{categoriaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "{{categoriaNombre}} editada"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
