meta {
  name: Registrar compra
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/compras
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "proveedor_id": 1,
    "items": [
      { "producto_id": 1, "cantidad": 2, "costo_unitario": 10.5 }
    ]
  }
}

script:post-response {
  bru.setVar("compraId", res.getBody().id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
