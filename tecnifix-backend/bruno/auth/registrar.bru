meta {
  name: Registrar usuario de prueba
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Usuario Bruno",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("se crea, o ya existía", function () {
    expect([201, 400]).to.include(res.getStatus());
  });
}
