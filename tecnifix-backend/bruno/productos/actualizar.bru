meta {
  name: Actualizar producto
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/productos/{{productoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "sku": "{{productoSku}}",
    "nombre": "Producto Bruno editado",
    "categoria_id": 1,
    "precio_compra": 18,
    "precio_venta": 25.5,
    "stock_minimo": 5
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
