meta {
  name: Crear producto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "sku": "{{productoSku}}",
    "nombre": "Producto Bruno",
    "categoria_id": 1,
    "precio_compra": 18,
    "precio_venta": 25.5,
    "stock_minimo": 5
  }
}

script:pre-request {
  bru.setVar("productoSku", "BRU-" + Date.now());
}

script:post-response {
  bru.setVar("productoId", res.getBody().id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
